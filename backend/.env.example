APP_NAME=TireAI
ENV=local


ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

UPLOAD_DIR=uploads

# OCR (เริ่มจาก API ก่อน)
OCR_PROVIDER=http_api
OCR_HTTP_ENDPOINT=http://localhost:9001/ocr
OCR_HTTP_API_KEY=

# Push (ไม่ใช้ Firebase -> OneSignal)
PUSH_PROVIDER=onesignal
ONESIGNAL_APP_ID=YOUR_ONESIGNAL_APP_ID
ONESIGNAL_API_KEY=YOUR_ONESIGNAL_REST_API_KEY

# AI Models
infer_device=cpu
det_model_path=app/models/det_tire_code.pt
rec_model_path=app/models/rec_tire_code.pth
depth_model_path=app/models/depth_tire.pth
use_internal_recog=true
crnn_charset=0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ
