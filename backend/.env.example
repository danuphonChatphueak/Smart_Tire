APP_NAME=TireAI
ENV=local


ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

UPLOAD_DIR=uploads

# OCR (เริ่มจาก API ก่อน)
OCR_PROVIDER=http_api
OCR_HTTP_ENDPOINT=http://localhost:9001/ocr
OCR_HTTP_API_KEY=

# Push (ไม่ใช้ Firebase -> OneSignal)
PUSH_PROVIDER=onesignal
ONESIGNAL_APP_ID=YOUR_ONESIGNAL_APP_ID
ONESIGNAL_API_KEY=YOUR_ONESIGNAL_REST_API_KEY

# AI Models
infer_device=cpu
det_model_path=app/models/det_tire_code.pt
rec_model_path=app/models/rec_tire_code.pth
depth_model_path=app/models/depth_tire.pth
mask_model_path=app/models/mask.pt
use_internal_recog=true
crnn_charset=0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ

# Gap-pixel Calibration: depth = A * ln(gap_px) + B
# รันก่อน: python g.py เพื่อหาค่า A, B จากข้อมูล ground truth
gap_calib_a=2.85
gap_calib_b=-8.10

# Strict Filtering Thresholds
gap_min_count=10
gap_min_px=60.0
gap_max_px=200.0
gap_max_cv=0.18
gap_max_mad=10.0
gap_min_depth_mm=1.6
gap_max_depth_mm=8.5
